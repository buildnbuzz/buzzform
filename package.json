{
  "name": "buzzform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @buildnbuzz/buzzform publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@tanstack/intent": "0.0.23",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsup": "^8.3.5",
    "turbo": "^2.7.2",
    "typescript": "5.9.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1"
  }
}
